# Hindi Anime Guide - Environment Configuration
APP_NAME="Hindi Anime Guide"
APP_DESCRIPTION="भारत में एनीमे कहाँ देखें, हिंदी डब गाइड"
ENV="development"
DEBUG=True
SECRET_KEY="change-this-in-production-to-a-secure-random-string-at-least-32-chars"
DATABASE_URL="sqlite:///./anime_hindi.db"
HOST="127.0.0.1"
PORT=8000
SEED_SAMPLE_DATA=False
ADS_ENABLED=False
SHOW_SAMPLE_BANNER=True

# Author name for article bylines (leave empty for no author byline)
AUTHOR_NAME=""

# Google OAuth
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
PUBLIC_BASE_URL="http://127.0.0.1:8000"

# SMTP Configuration for Email OTP (Fallback)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@animeguide.com"

# HTTPS Email APIs (Brevo / Resend - Render Free Plan Compatible)
EMAIL_PROVIDER=""
BREVO_API_KEY=""
RESEND_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="Hindi Anime Guide"

# Device Trust (days to remember device and skip email OTP; 0 disables)
OTP_TRUST_DEVICE_DAYS=30

# ==========================================================
# Local Docker PostgreSQL & pgAdmin Configuration
# ==========================================================
# pgAdmin Web URL: http://localhost:5050
# Local Postgres connection string:
# LOCAL_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/anime_guide"
LOCAL_DB_HOST="127.0.0.1"
LOCAL_DB_PORT=5432
LOCAL_DB_NAME="anime_guide"
LOCAL_DB_USER="postgres"
LOCAL_DB_PASSWORD=""
PGADMIN_URL="http://localhost:5050"


